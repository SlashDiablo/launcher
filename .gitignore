# Build output
deploy/
darwin/
slashdiablo-launcher
slashdiablo-launcher.exe

# Generated by therecipe/qt (qtmoc and qtrcc). Everything here is Go and QML,
# so any C++ in the tree is generated, which is why these patterns are broad.
moc*.*
rcc*.*
*.cpp
*.h
*.qrc
*.o
*.qmlc
*-packr.go

# Packaging
installer/output/
*.dmg

# Local test environment. Fixtures come from testenv/make_fixtures.py and
# serve.out/serve.err are the local file server's logs.
testenv/files/
testenv/d2/
testenv/serve.out
testenv/serve.err

# Diablo II runtime files, written when the launcher runs from the repo root
BnetLog.txt
D2HD.ini

# OS
*.DS_Store
